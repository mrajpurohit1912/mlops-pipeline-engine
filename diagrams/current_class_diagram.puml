' }

' ' The Main Entry Point (The "Glue")
' class TabularClassificationPipeline {
'     - config_engine: ConfigurationEngine
'     - orchestrator: PipelineOrchestrator
'     + run()
' }

' ' Concrete Implementations
' class CSVIngestorTask implements TaskBase
' class MissingValueValidatorTask implements TaskBase

' ' Relationships
' TabularClassificationPipeline o-- ConfigurationEngine
' TabularClassificationPipeline o-- PipelineOrchestrator

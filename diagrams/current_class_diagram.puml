@startuml
class main {
    +  yaml_parser
    +  schema_validator
    +  dag_generator
    +  configuration_engine
    +  orchestrator
    +  tabular_classification_pipeline

    + run ()
}


class TabularClassificationPipeline {
    + configuration_engine
    + orchestrator

    + run()
}   


class ConfigurationEngine {
    + yaml_parser
    + schema_validator
    + dag_generator

    + build_execution_plan()
}

class PipelineOrchestrator {
    run() # executes task one by one
}


class DAGGenerator {
    + generate() # returns DAG Plan List[TaskBase]
}

class DataIngestorFactory {
    + get_ingestor()
}

class DataValidatorFactory {
    + get_validator()
}

abstract class TaskBase {
    + run () #abstract method
}


Interface CSVIngestorTask  {
    + run () # implementation of abstract method TaskBase.run()
}

Interface MissingValueValidatorTask  {
    + run ()  # implementation of abstract method TaskBase.run()
}

Interface DataTypeValidatorTask  {
    + run ()  # implementation of abstract method TaskBase.run()
}

abstract class ParserBase {
    + parse() # abstract method
}

Interface YAMLParser  {
    + parse() # implementation of abstract method ParserBase.parse()
}

class MLConfig {
    # it is a pydantic model class
}

class SchemaValidator {
    + validate() # validates MLConfig instance  
}


main --> TabularClassificationPipeline : uses

TabularClassificationPipeline --> ConfigurationEngine : uses using dependency injection
TabularClassificationPipeline --> PipelineOrchestrator : uses using dependency injection

DAGGenerator --> TaskBase : uses
DAGGenerator --> DataIngestorFactory : uses
DAGGenerator --> DataValidatorFactory : uses    

ConfigurationEngine *-- DAGGenerator    : Part of # DAGGenerator is part of ConfigurationEngine


TaskBase <|.. CSVIngestorTask
TaskBase <|.. MissingValueValidatorTask
TaskBase <|.. DataTypeValidatorTask

ParserBase <|.. YAMLParser

ConfigurationEngine *-- YAMLParser : Part of # YAMLParser is part of ConfigurationEngine

ConfigurationEngine *-- SchemaValidator : Part of # SchemaValidator is part of ConfigurationEngine

SchemaValidator --> MLConfig : validates # validates MLConfig instance

DataValidatorFactory ..> TaskBase : <<creates>> # returns task instances
DataIngestorFactory ..> TaskBase : <<creates>> # returns task instances

PipelineOrchestrator ..> TaskBase : <<executes>> # executes task one by one
@enduml



